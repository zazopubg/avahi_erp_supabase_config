# ============================================================
# backend/.env.example
# انسخ هذا الملف إلى backend/.env قبل تشغيل docker-compose.yml
# (لا تُدرِج backend/.env أبداً في نظام التحكم بالإصدار — راجع
# .gitignore الجذري). القيم أدناه هي "أسرار تطوير محلية قياسية"
# يستخدمها مجتمع Supabase بالكامل لمشاريع self-hosted محلية؛
# استبدلها حتماً بقيم فريدة قبل أي نشر حقيقي.
# ============================================================

# ── قاعدة البيانات ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# ── JWT المشترك بين كل خدمات Supabase (auth/rest/realtime/storage) ──
# ⚠️ هذا هو مفتاح JWT الافتراضي القياسي لبيئات التطوير المحلي فقط.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# مفتاحان مُشتقّان من JWT_SECRET أعلاه بدور anon/service_role
# (القيم القياسية المستخدمة في التطوير المحلي لـ Supabase CLI).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.M2d2z4SFn5C8dgxDLoY0LbGGqwXAaZQvXA9WLUxV6-w

# ── عنوان المشروع محلياً ─────────────────────────────────────
API_EXTERNAL_URL=http://localhost:54321
SUPABASE_PUBLIC_URL=http://localhost:54321
SITE_URL=http://localhost:3000
STUDIO_PORT=54323
KONG_HTTP_PORT=54321
INBUCKET_PORT=54324

# ── Edge Functions (backend/supabase/functions) ─────────────
# أسرار مشتركة يتحقق منها functions/_shared/auth.ts::verifySharedSecret
# لتأمين استدعاءات Database Webhooks والمهام المجدولة (cron) التي لا
# تحمل JWT مستخدم حقيقي.
DB_WEBHOOK_SECRET=change-me-webhook-secret
CRON_SECRET=change-me-cron-secret

# إعدادات دالة equipment-alert (اختيارية، القيم الافتراضية معقولة)
EQUIPMENT_USAGE_HOURS_THRESHOLD=250
EQUIPMENT_DUE_SOON_DAYS=7
EQUIPMENT_ALERT_DEDUPE_DAYS=3

# ── البريد التجريبي (Inbucket) ────────────────────────────────
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_ADMIN_EMAIL=admin@avahi.dev
SMTP_SENDER_NAME=Avahi (Local Dev)
